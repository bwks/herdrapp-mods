# Only personal Herdr files are tracked; Herdr writes or rewrites everything else here.
/*
!/.gitignore
!/README.md
!/keys.json
!/settings.json
!/layouts/
/layouts/*
!/layouts/my-main.json
!/mods/
/mods/*
!/mods/my-changes/
!/mods/toggle-changes/
!/mods/backlog/
!/mods/toggle-backlog/
!/mods/AGENTS.md
# Herdr rewrites these in every mod folder
*.d.ts
jsconfig.json
